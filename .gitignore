# Installed dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Generated Vite / Electron output (source assets are in src/public)
/build/
/dist/
/dist-electron/
/release/
/release-next/
/out/
/output/
/.electron-cache/
/.electron-builder-cache/
/*.exe
/*.blockmap
/latest*.yml
*.tgz

# Logs, crash diagnostics and runtime process files
logs/
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.pid.lock

# Test reports and development caches
coverage/
.nyc_output/
*.lcov
/playwright-report/
/test-results/
.cache/
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo
.node_repl_history

# Local credentials and environment overrides; keep distributable templates
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
/.npmrc
*.key
*.p12
*.pfx
*.jks
*.keystore
*-key.pem
*-private.pem
id_rsa
id_ed25519

# Local assistant installations and generated codebase indexes
/.agents/skills/
/.codebase-memory/
/.codex/
/.claude/

# Python caches created by local development tools
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Machine-specific editor state; shared VS Code project settings stay versioned
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.suo
*.user
*.swp
*.swo
*~
*.tmp
*.temp
*.bak

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/