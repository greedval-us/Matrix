{
  "name": "matrix",
  "version": "1.0.3",
  "description": "Desktop gRPC client for Matrix Search powered by Manticore.",
  "author": "Matrix Team",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "npm run build:preload && concurrently -k \"vite\" \"vite build --config vite.preload.config.js --watch\" \"wait-on http://localhost:5173 build/main/preload.cjs && cross-env MATRIX_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "npm run build:client && electron .",
    "build:preload": "vite build --config vite.preload.config.js",
    "build:client": "npm run build:preload && vite build",
    "build": "npm run build:client && cross-env ELECTRON_CACHE=.electron-cache ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder",
    "build:linux": "npm run build:client && cross-env ELECTRON_CACHE=.electron-cache ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder --linux AppImage",
    "build:win": "npm run build:client && cross-env ELECTRON_CACHE=.electron-cache ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder --win nsis portable",
    "test": "npm run test:client",
    "test:client": "node --test tests/main/services/*.test.js",
    "test:ui": "node scripts/checkClientUi.mjs",
    "test:visual": "electron scripts/checkVisuals.mjs",
    "test:preload": "npm run build:preload && node scripts/checkPreload.mjs",
    "client:check": "node scripts/checkClientGrpc.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.example.myapp",
    "productName": "Matrix",
    "directories": {
      "output": "dist",
      "buildResources": "src/public"
    },
    "files": [
      "build/renderer/",
      "build/main/",
      "src/"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "matrix.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "matrix.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "electron-log": "^5.4.3",
    "electron-store": "^10.1.0",
    "lucide-vue-next": "^0.536.0",
    "pdfmake": "^0.2.20",
    "pinia": "^3.0.3",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^38.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.6",
    "vue": "^3.5.18",
    "wait-on": "^8.0.4"
  }
}
